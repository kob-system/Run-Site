{
  "redirects": [
    {
      "source": "/josh",
      "destination": "/remodelers?ref=josh&utm_source=flyer&utm_medium=referral&utm_campaign=josh-stack",
      "permanent": false
    },
    {
      "source": "/fb",
      "destination": "/remodelers?ref=fb&utm_source=facebook&utm_medium=group&utm_campaign=fb-groups",
      "permanent": false
    },
    {
      "source": "/ghl",
      "destination": "/switch?utm_source=meta&utm_medium=paid-social&utm_campaign=ghl-takeover",
      "permanent": false
    },
    { "source": "/job-costing-app-for-contractors", "destination": "/", "permanent": true },
    { "source": "/job-costing-app-for-contractors/", "destination": "/", "permanent": true },
    { "source": "/contractor-profit-tracking", "destination": "/", "permanent": true },
    { "source": "/contractor-profit-tracking/", "destination": "/", "permanent": true },
    { "source": "/crew-time-tracking-app", "destination": "/", "permanent": true },
    { "source": "/crew-time-tracking-app/", "destination": "/", "permanent": true },
    { "source": "/best-job-costing-app-for-small-contractors", "destination": "/", "permanent": true },
    { "source": "/best-job-costing-app-for-small-contractors/", "destination": "/", "permanent": true },
    { "source": "/labor-burden-for-contractors", "destination": "/", "permanent": true },
    { "source": "/labor-burden-for-contractors/", "destination": "/", "permanent": true },
    { "source": "/compare/jobber", "destination": "/", "permanent": true },
    { "source": "/compare/jobber/", "destination": "/", "permanent": true },
    { "source": "/compare/housecall-pro", "destination": "/", "permanent": true },
    { "source": "/compare/housecall-pro/", "destination": "/", "permanent": true },
    { "source": "/compare/quickbooks", "destination": "/", "permanent": true },
    { "source": "/compare/quickbooks/", "destination": "/", "permanent": true },
    { "source": "/guides/job-costing", "destination": "/", "permanent": true },
    { "source": "/guides/job-costing/", "destination": "/", "permanent": true },
    { "source": "/features", "destination": "/", "permanent": true },
    { "source": "/features/", "destination": "/", "permanent": true },
    { "source": "/pricing", "destination": "/#tiers", "permanent": true },
    { "source": "/pricing/", "destination": "/#tiers", "permanent": true },
    { "source": "/faq", "destination": "/", "permanent": true },
    { "source": "/faq/", "destination": "/", "permanent": true },
    { "source": "/your-data", "destination": "/", "permanent": true },
    { "source": "/your-data/", "destination": "/", "permanent": true }
  ],
  "rewrites": [
    { "source": "/((?!api/).*)", "destination": "/index.html" }
  ],
  "crons": [
    { "path": "/api/weekly-digest", "schedule": "0 12 * * 5" }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        { "key": "Strict-Transport-Security", "value": "max-age=63072000; includeSubDomains; preload" },
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "X-Frame-Options", "value": "DENY" },
        { "key": "Referrer-Policy", "value": "strict-origin-when-cross-origin" },
        { "key": "Permissions-Policy", "value": "camera=(self), microphone=(self), geolocation=(self), payment=(self), usb=(), interest-cohort=()" },
        { "key": "Content-Security-Policy", "value": "default-src 'self'; script-src 'self' 'unsafe-inline'; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob: https://*.supabase.co; font-src 'self' data:; connect-src 'self' https://*.supabase.co wss://*.supabase.co https://api.resend.com; frame-ancestors 'none'; base-uri 'self'; object-src 'none'; form-action 'self'; upgrade-insecure-requests" }
      ]
    }
  ]
}
